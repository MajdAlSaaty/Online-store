rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a signed-in user whose UID has a document in /admins/{uid}
    // (create it manually in the Firebase console; clients can never write it).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public order tracking: status only, no personal data.
    match /tracking/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        code.matches('^ORD-[A-F0-9]{24}$')
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }

    // Orders contain personal data: admin-only read. Guests may only create.
    match /orders/{orderId} {
      allow get, list: if isAdmin();

      allow create: if orderId.matches('^ORD-[A-F0-9]{24}$')
        && request.resource.data.keys().hasOnly(['orderNumber','customer','items','subtotal','deliveryFee','total','currency','paymentMethod','deliveryEstimated','status','createdAt'])
        && request.resource.data.orderNumber == orderId
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'COD'
        && request.resource.data.customer.keys().hasOnly(['fullName','phone','city','address','notes'])
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.fullName.size() >= 2
        && request.resource.data.customer.fullName.size() <= 100
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 9
        && request.resource.data.customer.phone.size() <= 20
        && request.resource.data.customer.city is string
        && request.resource.data.customer.city.size() >= 2
        && request.resource.data.customer.city.size() <= 100
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() <= 500
        && request.resource.data.customer.notes is string
        && request.resource.data.customer.notes.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.total is number
        && math.abs(request.resource.data.total - (request.resource.data.subtotal + request.resource.data.deliveryFee)) < 0.01
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
